{
  "schema": 1,
  "id": "rust_standard_specular",
  "name": "Rust Standard (Spec/Gloss)",
  "description": "Rust's spec/gloss variant used for skins: _bc as diffuse, _sg (specular RGB, gloss A), _nrm (OpenGL), _ao.",
  "normal_format": "OPENGL",
  "gloss_curve": "LINEAR",
  "ignore": ["bc_ao", "hm_ao_gloss"],
  "slots": [
    {
      "id": "bc",
      "label": "Base Color",
      "suffixes": ["bc"],
      "channels": {"RGB": "diffuse"}
    },
    {
      "id": "sg",
      "label": "Specular Gloss",
      "suffixes": ["sg"],
      "channels": {"RGB": "specular", "A": "gloss"}
    },
    {
      "id": "nrm",
      "label": "Normal",
      "suffixes": ["nrm"],
      "channels": {"RGB": "normal"}
    },
    {
      "id": "ao",
      "label": "Ambient Occlusion",
      "suffixes": ["ao"],
      "channels": {"R": "ao"}
    },
    {
      "id": "disp",
      "label": "Displacement",
      "suffixes": ["disp"],
      "channels": {"R": "height"}
    },
    {
      "id": "em",
      "label": "Emission",
      "suffixes": ["em"],
      "channels": {"RGB": "emission"}
    },
    {
      "id": "a",
      "label": "Alpha",
      "suffixes": ["a"],
      "channels": {"R": "alpha"}
    }
  ]
}

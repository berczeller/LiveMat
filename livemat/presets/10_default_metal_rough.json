{
  "schema": 1,
  "id": "default_metal_rough",
  "name": "Default (Metal/Rough)",
  "description": "One file per map, as exported by Substance 3D Painter's PBR Metallic Roughness template.",
  "normal_format": "OPENGL",
  "gloss_curve": "LINEAR",
  "slots": [
    {
      "id": "base_color",
      "label": "Base Color",
      "suffixes": ["basecolor", "base_color", "albedo", "color", "col", "bc"],
      "channels": {"RGB": "base_color"}
    },
    {
      "id": "metallic",
      "label": "Metallic",
      "suffixes": ["metallic", "metalness", "metal", "met"],
      "channels": {"R": "metallic"}
    },
    {
      "id": "roughness",
      "label": "Roughness",
      "suffixes": ["roughness", "rough", "rgh"],
      "channels": {"R": "roughness"}
    },
    {
      "id": "normal",
      "label": "Normal",
      "suffixes": ["normal", "normal_opengl", "normalgl", "nrm", "nor", "n"],
      "channels": {"RGB": "normal"}
    },
    {
      "id": "ao",
      "label": "Ambient Occlusion",
      "suffixes": ["ambientocclusion", "ambient_occlusion", "mixed_ao", "occlusion", "ao"],
      "channels": {"R": "ao"}
    },
    {
      "id": "height",
      "label": "Height",
      "suffixes": ["height", "displacement", "disp", "hgt"],
      "channels": {"R": "height"}
    },
    {
      "id": "emission",
      "label": "Emissive",
      "suffixes": ["emissive", "emission", "emit"],
      "channels": {"RGB": "emission"}
    },
    {
      "id": "opacity",
      "label": "Opacity",
      "suffixes": ["opacity", "alpha", "transparency"],
      "channels": {"R": "alpha"}
    }
  ]
}
